{
  "name": "mmbadges",
  "version": "0.4.0",
  "private": true,
  "description": "Modern minimal badges for Markdown. Clean pills, real brand logos, light and dark mode.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node cli/brands.mjs && node cli/status.mjs",
    "brands": "node cli/brands.mjs",
    "status": "node cli/status.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site:index": "node site/scripts/build-index.mjs",
    "site:dev": "npm run site:index && vite --config site/vite.config.js",
    "site:build": "npm run site:index && vite build --config site/vite.config.js",
    "dev": "npm run site:build && wrangler dev",
    "deploy": "npm run site:build && wrangler deploy",
    "examples": "node cli/examples.mjs",
    "banner": "node cli/banner.mjs"
  },
  "dependencies": {
    "lucide-static": "^1.0.0",
    "simple-icons": "^16.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  },
  "license": "MIT"
}
